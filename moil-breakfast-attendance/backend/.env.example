PORT=4000
# Comma-separated list of origins allowed to call this API (your frontend dev/prod URLs)
CORS_ORIGIN=http://localhost:5173
# Where the SQLite database file is stored
DB_PATH=./data/moil.sqlite
# Default staff PIN used only the very first time the database is created
DEFAULT_PIN=2468
# How many weeks per term the app supports (matches the design's W1-W10 pills)
TOTAL_WEEKS=10
